    "film_sites": [
      "bridge",
      "decoder4",
      "decoder3",
      "decoder2",
      "decoder1"
    ],
    "film_equation": "F_hat = (1 + gamma(t)) * F + beta(t); gamma=tanh(gamma_raw), beta=tanh(beta_raw)",
